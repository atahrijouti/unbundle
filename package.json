{
  "name": "unbundle",
  "version": "0.2.0",
  "type": "module",
  "private": true,
  "description": "I don't like bundling",
  "scripts": {
    "build": "node build.js",
    "typecheck": "tsc",
    "lint": "eslint",
    "format": "prettier --write .",
    "check": "prettier --check . && tsc && tsc -p sample-site && eslint",
    "sample": "pnpm build && pnpm --filter sample-site dev",
    "sample:build": "pnpm build && pnpm --filter sample-site build"
  },
  "bin": {
    "unbundle-serve": "./dist/server/index.js",
    "unbundle-build": "./dist/server/build.js"
  },
  "exports": {
    ".": {
      "import": "./dist/client/index.js",
      "types": "./lib/client/index.ts"
    },
    "./eslint": {
      "import": "./eslint/unbundle.js",
      "types": "./eslint/unbundle.d.ts"
    }
  },
  "files": [
    "build.js",
    "dist/",
    "eslint/",
    "lib/",
    "LICENSE",
    "README.md"
  ],
  "dependencies": {
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/ws": "^8.18.2",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
