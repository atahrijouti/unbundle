{
  "name": "unbundle",
  "version": "0.1.2",
  "type": "module",
  "private": true,
  "description": "I don't like bundling",
  "scripts": {
    "build": "node build.js"
  },
  "bin": {
    "unbundle-serve": "./dist/server/index.js",
    "unbundle-build": "./dist/server/build.js"
  },
  "exports": {
    ".": {
      "import": "./dist/client/index.js",
      "types": "./lib/client/index.ts"
    },
    "./eslint": {
      "import": "./eslint/unbundle.js",
      "types": "./eslint/unbundle.d.ts"
    }
  },
  "files": [
    "build.js",
    "dist/",
    "eslint/",
    "lib/",
    "LICENSE",
    "README.md"
  ],
  "dependencies": {
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/ws": "^8.18.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
